{
    "extends": "lighthouse:default",
    "settings": {
        "onlyCategories": [
            "performance",
            "accessibility",
            "best-practices",
            "seo"
        ],
        "emulatedFormFactor": "mobile",
        "throttling": {
            "rttMs": 40,
            "throughputKbps": 11024,
            "cpuSlowdownMultiplier": 1
        },
        "skipAudits": [
            "uses-webp-images"
        ]
    },
    "audits": {
        "largest-contentful-paint": {
            "options": {
                "numericValue": 2500
            }
        },
        "first-contentful-paint": {
            "options": {
                "numericValue": 1800
            }
        },
        "cumulative-layout-shift": {
            "options": {
                "numericValue": 0.1
            }
        }
    }
}