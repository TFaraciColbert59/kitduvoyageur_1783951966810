{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "src/features/live-segments/**/*.ts",
    "src/components/live-segments/**/*.ts",
    "src/components/live-segments/**/*.tsx",
    "src/lib/live-segments/**/*.ts",
    "src/app/api/live-segments/**/*.ts",
    "src/app/live-segments/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
