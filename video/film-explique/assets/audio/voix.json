[
 {
  "i": 1,
  "text": "Cinq jours en Patagonie. Rien oublié.",
  "start": 0.44,
  "end": 2.668
 },
 {
  "i": 2,
  "text": "Tu écris une phrase…",
  "start": 3.42,
  "end": 4.528
 },
 {
  "i": 3,
  "text": "et le Kit du Voyageur prépare tout.",
  "start": 5.03,
  "end": 6.725
 },
 {
  "i": 4,
  "text": "L'itinéraire, jour par jour.",
  "start": 7.46,
  "end": 9.346
 },
 {
  "i": 5,
  "text": "Quatre refuges, réservés.",
  "start": 13.5,
  "end": 15.27
 },
 {
  "i": 6,
  "text": "La météo, au bon moment.",
  "start": 15.45,
  "end": 16.749
 },
 {
  "i": 7,
  "text": "Le sac, au gramme près.",
  "start": 16.929,
  "end": 18.187
 },
 {
  "i": 8,
  "text": "Le budget, partagé à trois.",
  "start": 18.367,
  "end": 19.953
 },
 {
  "i": 9,
  "text": "La carte, même sans réseau.",
  "start": 20.133,
  "end": 21.745
 },
 {
  "i": 10,
  "text": "Et ta mère te suit, en direct.",
  "start": 21.926,
  "end": 23.615
 },
 {
  "i": 11,
  "text": "Toi, tu n'as plus qu'à partir.",
  "start": 24.62,
  "end": 26.419
 },
 {
