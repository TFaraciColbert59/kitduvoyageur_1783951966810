{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/lkdv-autonomous-2026-10-29": false
    }
  },
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    }
  ],
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=8192 next build --no-lint"
}
