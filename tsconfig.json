{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-4000/types/**/*.ts",
    ".next-4003/types/**/*.ts",
    ".next-build-check/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-repair/types/**/*.ts",
    ".next/next-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "types/**/*.d.ts",
    ".next-v7-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "resources",
    "scripts",
    "scratch",
    "geo_data",
    "public",
    ".next",
    ".next-codex-build"
  ]
}
