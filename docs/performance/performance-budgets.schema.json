{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./performance-budgets.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baselineDate",
    "notes",
    "webVitals",
    "explorer",
    "regressionPolicy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baselineDate": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "webVitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lcp_ms_p75_max",
        "inp_ms_p75_max",
        "cls_p75_max"
      ],
      "properties": {
        "lcp_ms_p75_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inp_ms_p75_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cls_p75_max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell_first_load_js_kib_max",
        "shared_js_kib_reference",
        "maplibre_gzip_kib_max",
        "maplibre_raw_kib_reference"
      ],
      "properties": {
        "shell_first_load_js_kib_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shared_js_kib_reference": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maplibre_gzip_kib_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maplibre_raw_kib_reference": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "regressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_percent",
        "latency_absolute_ms",
        "compressed_asset_kib"
      ],
      "properties": {
        "latency_percent": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "latency_absolute_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compressed_asset_kib": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
