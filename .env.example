# ── LKDV — Variables d'environnement ─────────────────────────────────────────
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore). Ne jamais mettre de
# valeurs réelles dans ce fichier d'exemple ni dans le code source.

# Supabase (obligatoire — plus aucun fallback en dur, voir src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de rôle service Supabase — SERVEUR UNIQUEMENT (cache IA, queries admin).
# Ne JAMAIS l'exposer côté client ni la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Routeur IA — NVIDIA Nemotron via OpenRouter (https://openrouter.ai/keys).
# Sans cette clé, les features IA renvoient une erreur typée gracieuse.
OPENROUTER_API_KEY=

# URL publique du site (transmise à OpenRouter comme HTTP-Referer)
NEXT_PUBLIC_SITE_URL=

# Secret des crons IA (Authorization: Bearer sur /api/cron/*) — jamais commité
CRON_SECRET=

# Web Push VAPID (notifications « carnet prêt », chantier récit post-randonnée)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Providers IA legacy (rétrocompatibilité — optionnels)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe (server-side uniquement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Tripadvisor (Terra en priorité, Content API legacy en secours) ───────────
# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_ ni commiter de valeur.
# Auth Terra : en-tête X-API-KEY (jamais en URL). Auth legacy : paramètre ?key=
# Sélection du transport côté serveur : `terra` | `legacy`.
# Sans valeur : Terra si TRIPADVISOR_TERRA_API_KEY est présente, sinon legacy.
TRIPADVISOR_PROVIDER=
# Plateforme Terra (recommandée — la Content API legacy est dépréciée/sunset)
TRIPADVISOR_TERRA_API_KEY=
TRIPADVISOR_TERRA_API_BASE_URL=https://terra.tripadvisor.com/api
# ── Legacy Content API (secours uniquement) ──────────────────────────────────
TRIPADVISOR_API_KEY=
TRIPADVISOR_API_BASE_URL=https://api.content.tripadvisor.com/api/v1
# Optionnel commun : timeout (ms) et Referer (si restriction domaine legacy).
TRIPADVISOR_TIMEOUT_MS=
TRIPADVISOR_REFERER=
# Optionnel : URL du logo d'attribution fournie/autorisée par Tripadvisor
# (surcharge le placeholder par défaut).
TRIPADVISOR_LOGO_URL=

# ── Découverte / affiliation (Klook via Travelpayouts) ────────────────────────
# Fournisseur de la couche découverte {serveur} : viator | klook | terra | legacy | editorial.
# Prod = klook. Aucun fallback automatique entre fournisseurs.
DISCOVERY_PROVIDER=klook
# Interrupteur dur Terra. Défaut = false : aucun appel Terra, clé non lue.
DISCOVERY_TERRA_ENABLED=false
# ── Viator Affiliate API (fixtures/tests sans clé ; live uniquement si fournie) ─
# SERVEUR UNIQUEMENT — en-tête exp-api-key, jamais en URL, jamais NEXT_PUBLIC_*.
VIATOR_API_KEY=
VIATOR_API_BASE_URL=https://api.viator.com/partner
VIATOR_TIMEOUT_MS=
# Mapping destination PAR PAYS (JSON), officiel. Aucun ID global en production.
# Ex. : VIATOR_DESTINATION_IDS={"IS":"<id>","FR":"<id>","JP":"<id>"}
VIATOR_DESTINATION_IDS=
VIATOR_LANGUAGE=fr
# CI-DESSOUS : utilisé UNIQUEMENT par scripts/viator-live-check.mjs (jamais en prod).
VIATOR_DESTINATION_ID=
VIATOR_LANGUAGE=fr
# Tag(s) Viator (numériques) filtrant les expériences culinaires (Gastronomie).
# Sans ce filtre, aucun bloc Viator n'apparaît en Gastronomie (aucun tag inventé).
VIATOR_CULINARY_TAG_ID=
# Lien Klook officiel généré par le tableau de bord Travelpayouts (serveur).
# Vide = repli sur https://www.klook.com/ (officiel, NON affilié → aucun tracking).
# Ne JAMAIS préfixer NEXT_PUBLIC_. Ne jamais scraper Klook.
KLOOK_AFFILIATE_URL=
# Marqueur Travelpayouts (public, non secret) si génération de liens côté serveur.
TRAVELPAYOUTS_MARKER=
