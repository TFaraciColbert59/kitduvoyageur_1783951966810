# ── LKDV — Variables d'environnement ─────────────────────────────────────────
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore). Ne jamais mettre de
# valeurs réelles dans ce fichier d'exemple ni dans le code source.

# Supabase (obligatoire — plus aucun fallback en dur, voir src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de rôle service Supabase — SERVEUR UNIQUEMENT (cache IA, queries admin).
# Ne JAMAIS l'exposer côté client ni la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Routeur IA — NVIDIA Nemotron via OpenRouter (https://openrouter.ai/keys).
# Sans cette clé, les features IA renvoient une erreur typée gracieuse.
OPENROUTER_API_KEY=

# URL publique du site (transmise à OpenRouter comme HTTP-Referer)
NEXT_PUBLIC_SITE_URL=

# Providers IA legacy (rétrocompatibilité — optionnels)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe (server-side uniquement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
