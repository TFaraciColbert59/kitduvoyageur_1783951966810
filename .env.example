# ── LKDV — Variables d'environnement ─────────────────────────────────────────
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore). Ne jamais mettre de
# valeurs réelles dans ce fichier d'exemple ni dans le code source.

# Supabase (obligatoire — plus aucun fallback en dur, voir src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de rôle service Supabase — SERVEUR UNIQUEMENT (cache IA, queries admin).
# Ne JAMAIS l'exposer côté client ni la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Routeur IA — NVIDIA Nemotron via OpenRouter (https://openrouter.ai/keys).
# Sans cette clé, les features IA renvoient une erreur typée gracieuse.
OPENROUTER_API_KEY=

# Provider IA PRIMAIRE - NVIDIA NIM en appel direct (https://build.nvidia.com/keys).
# Nemotron 3.5 Lightning, prioritaire sur le tier `fast` quand la cle est
# presente. Serveur UNIQUEMENT : ne jamais le prefixer par NEXT_PUBLIC_.
NVIDIA_API_KEY=

# URL publique du site (transmise à OpenRouter comme HTTP-Referer)
NEXT_PUBLIC_SITE_URL=

# Secret des crons IA (Authorization: Bearer sur /api/cron/*) — jamais commité
CRON_SECRET=

# Web Push VAPID (notifications « carnet prêt », chantier récit post-randonnée)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Providers IA legacy (rétrocompatibilité — optionnels)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe (server-side uniquement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seule valeur Stripe qui traverse le bundle client (Checkout Elements).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Cle Stripe restreinte (lecture seule) pour les rapports internes, si utilisee.
STRIPE_RESTRICTED_KEY=

# ── Tripadvisor (Terra en priorité, Content API legacy en secours) ───────────
# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_ ni commiter de valeur.
# Auth Terra : en-tête X-API-KEY (jamais en URL). Auth legacy : paramètre ?key=
# Sélection du transport côté serveur : `terra` | `legacy`.
# Sans valeur : Terra si TRIPADVISOR_TERRA_API_KEY est présente, sinon legacy.
TRIPADVISOR_PROVIDER=
# Plateforme Terra (recommandée — la Content API legacy est dépréciée/sunset)
TRIPADVISOR_TERRA_API_KEY=
TRIPADVISOR_TERRA_API_BASE_URL=https://terra.tripadvisor.com/api
# ── Legacy Content API (secours uniquement) ──────────────────────────────────
TRIPADVISOR_API_KEY=
TRIPADVISOR_API_BASE_URL=https://api.content.tripadvisor.com/api/v1
# Optionnel commun : timeout (ms) et Referer (si restriction domaine legacy).
TRIPADVISOR_TIMEOUT_MS=
TRIPADVISOR_REFERER=
# Optionnel : URL du logo d'attribution fournie/autorisée par Tripadvisor
# (surcharge le placeholder par défaut).
TRIPADVISOR_LOGO_URL=

# ── Découverte / affiliation (Klook via Travelpayouts) ────────────────────────
# Fournisseur de la couche découverte {serveur} : viator | klook | terra | legacy | editorial.
# Prod = klook. Aucun fallback automatique entre fournisseurs.
DISCOVERY_PROVIDER=klook
# Interrupteur dur Terra. Défaut = false : aucun appel Terra, clé non lue.
DISCOVERY_TERRA_ENABLED=false
# ── Préparateur / réservation unifiée ─────────────────────────────────────────
# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_ ni commiter de valeur.
# Lecture : src/features/booking/server/providerCredentials.ts (fail-closed, D-07).
# Un mode sans sa clé lève `credentials.incomplete` : jamais de repli silencieux.
# Fournisseur actif : routestack | viator | auto. Aucun fallback automatique
# entre fournisseurs ; `auto` suit le premier provider dont le mode n'est pas
# `disabled`.
BOOKING_PROVIDER=
# ── RouteStack — contrat canonique double-clé ────────────────────────────────
# ROUTESTACK_MODE : sandbox | production. Défaut = sandbox.
# Toute valeur inconnue retombe sur sandbox : aucun mode permissif par défaut.
ROUTESTACK_MODE=sandbox
# Slot sandbox. BASE_URL : racine MCP (sans /sse), l'ordre HMAC s'appuie dessus.
ROUTESTACK_SANDBOX_API_KEY=
ROUTESTACK_SANDBOX_PARTNER_SECRET=
ROUTESTACK_SANDBOX_BASE_URL=
# Slot production. Sans ROUTESTACK_FULL_API_KEY, `production` échoue proprement
# (fail-closed) au lieu de dégrader vers le sandbox.
ROUTESTACK_FULL_API_KEY=
ROUTESTACK_FULL_PARTNER_SECRET=
ROUTESTACK_FULL_BASE_URL=
# ── Viator — contrat canonique double-clé ────────────────────────────────────
# VIATOR_MODE : sandbox | full. Défaut = sandbox.
VIATOR_MODE=sandbox
VIATOR_SANDBOX_API_KEY=
VIATOR_SANDBOX_API_BASE_URL=
VIATOR_FULL_API_KEY=
VIATOR_FULL_API_BASE_URL=
# Triple verrou Viator (D-07) : VIATOR_MODE=full ET ce drapeau à true ET clé
# Full présente. Sans les trois, le checkout Viator reste refusé.
VIATOR_BOOKING_ENABLED=false
# ── Noms WIP acceptés en repli (rétrocompatibilité) ───────────────────────────
# Ignorés dès que le couple ROUTESTACK_MODE / VIATOR_MODE est défini. À
# migrer puis supprimer une fois le contrat canonique déployé partout.
ROUTESTACK_BOOKING_MODE=
ROUTESTACK_LIVE_ENABLED=
ROUTESTACK_API_KEY=
ROUTESTACK_API_SECRET=
ROUTESTACK_MCP_URL=
VIATOR_BOOKING_MODE=
VIATOR_BOOKING_FULL_ENABLED=
VIATOR_API_KEY=
VIATOR_API_BASE_URL=
# ── Attribution Viator (D-08) ────────────────────────────────────────────────
# buildViatorAttributionUrl REFUSE l'URL si campaign ∉ [a-zA-Z0-9-], si pid n'a
# pas 9 chiffres, ou si l'hôte sort de l'allowlist. medium=api est forcé.
# Sans PID/MCID renseignés, aucun lien sortant ne porte de commission.
VIATOR_PID=
VIATOR_MCID=
VIATOR_CAMPAIGN=
# ── Viator Affiliate API (couche découverte) ──────────────────────────────────
# SERVEUR UNIQUEMENT — en-tête exp-api-key, jamais en URL, jamais NEXT_PUBLIC_*.
VIATOR_TIMEOUT_MS=
# Mapping destination PAR PAYS (JSON), officiel. Aucun ID global en production.
# Ex. : VIATOR_DESTINATION_IDS={"IS":"<id>","FR":"<id>","JP":"<id>"}
VIATOR_DESTINATION_IDS=
# Surcharge par section du mapping de tags ci-dessous (JSON).
# Ex. : VIATOR_SECTION_TAGS={"gastronomie":[103],"culture":[113]}
VIATOR_SECTION_TAGS=
# CI-DESSOUS : utilisé UNIQUEMENT par scripts/viator-live-check.mjs (jamais en prod).
VIATOR_DESTINATION_ID=
VIATOR_LANGUAGE=fr
# Tag(s) Viator (numériques) filtrant les expériences culinaires (Gastronomie).
# Sans ce filtre, aucun bloc Viator n'apparaît en Gastronomie (aucun tag inventé).
VIATOR_CULINARY_TAG_ID=
# Lien Klook officiel généré par le tableau de bord Travelpayouts (serveur).
# Vide = repli sur https://www.klook.com/ (officiel, NON affilié → aucun tracking).
# Ne JAMAIS préfixer NEXT_PUBLIC_. Ne jamais scraper Klook.
KLOOK_AFFILIATE_URL=
# Marqueur Travelpayouts (public, non secret) si génération de liens côté serveur.
TRAVELPAYOUTS_MARKER=

# ── Secrets applicatifs (documentés ici, tous optionnels par défaut) ──────────
# Aucun n'est requis pour `npm run build`. Chacun garde une feature éteinte
# tant qu'il est vide — c'est le comportement voulu, pas une forgotterie.

# Équipage : signature des invitations d'un guide à son groupe.
CREW_INVITE_SECRET=
# Signature des documents de voyage générés (PDF/contrat) et lien de revoc.
DOC_SIGNING_SECRET=
# Soumission d'URL chez Bing/IndexNow. 8 a 128 hex, cle publique cote serveur.
INDEXNOW_KEY=
# Code de parrainage : signature du jeton KIT-REF- emis a un parrain.
KIT_REF_SECRET=
# Interrupteur du programme de royalties. Defaut = false : calcul inactif.
KIT_ROYALTY_ENABLED=false
# Envoi d'emails transactionnels (reservation confirmee, rappel). Cle Resend.
RESEND_API_KEY=
# Graine la base de demonstration. Sans lui, les scripts de seed s'arretent.
SEED_SECRET=
# Signature des webhooks entrants Travelpayouts (marqueurs, conversions).
TRAVELPAYOUTS_WEBHOOK_SECRET=

# ── Drapeaux de développement ────────────────────────────────────────────────
# Aucun n'est active en production. Ils branchent des outils de mesure et un
# laboratoire de design ; tous sont fermes par defaut.

# Ouvre /dev/glass et /dev/style. Refuse hors NODE_ENV=development.
LKDV_GLASS_LAB=0
# Trace SSR dans la sortie console (perf de rendu). 1 = active.
LKDV_TRACE_SSR=0
# Journalise la trace d'observabilite pendant les tests. 1 = active.
OBSERVABILITY_LOG=0

# ── Variables publiques (NEXT_PUBLIC_*) ──────────────────────────────────────
# Elles sont inlinées dans le bundle : ne JAMAIS y mettre de secret.

# Cle de verification Google Search Console (meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# ID de mesure Google Analytics 4. Vide = aucun traceur.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Bascule l'interface en anglais en plus du francais.
NEXT_PUBLIC_I18N_EN_ENABLED=false
# Repli d'itineraire quand le moteur FF est indisponible. Vide = desactive.
NEXT_PUBLIC_FF_ITINERARY_FALLBACK=
